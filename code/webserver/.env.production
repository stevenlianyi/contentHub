VITE_API_BASE_URL=/chapi
# Step 8：上传通道走 /upload（部署侧由 nginx upload 模块注入 file.* 字段后转交后端 /hfile；直打 /hfile 会缺字段报 D3）
VITE_UPLOAD_URL=/upload
VITE_USE_MOCK=false
# ★ 2026-09-22：部署路径（本站部署节点 http://www.mindgrap.com/chapp/）
#   —— 决定 Vite base 与 router 的 hash base；改部署路径时**只需改这一行**并重新构建。
#   ★ 生产与开发态相同(/chapp/)，与 Step 0 的原始约定一致；如需再改路径只动本行。
VITE_BASE_PATH=/chapp/
